# Save as .github/workflows/update-builds.yml in your ZZZ-Archive-Asset repo
name: Update Prydwen build data

on:
  schedule:
    # Every Monday 06:00 UTC. Adjust to run after typical patch days if you'd rather.
    - cron: "0 6 * * 1"
  workflow_dispatch: {}  # lets you trigger it manually from the Actions tab too

jobs:
  scrape:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install requests beautifulsoup4

      - name: Run scraper
        id: scrape
        run: python scripts/scrape_prydwen.py --all --out data/builds
        continue-on-error: true  # so we can open an issue instead of just failing silently

      - name: Commit updated data
        if: steps.scrape.outcome == 'success'
        run: |
          git config user.name "build-data-bot"
          git config user.email "actions@users.noreply.github.com"
          git add data/builds
          git diff --cached --quiet || git commit -m "Update Prydwen build data ($(date -u +%Y-%m-%d))"
          git push

      - name: Open issue on failure
        if: steps.scrape.outcome == 'failure'
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `Build data scrape failed - ${new Date().toISOString().slice(0,10)}`,
              body: "The scheduled Prydwen scrape failed for one or more agents. " +
                    "Likely cause: page structure changed. Check the Action run logs, " +
                    "then re-run scripts/scrape_prydwen.py --dump-raw locally against " +
                    "a failing agent to see what changed.\n\n" +
                    `Run: ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`,
              labels: ["build-data", "needs-attention"]
            });
